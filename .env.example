NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_dev

# Set to true to run pending migrations on application boot
RUN_MIGRATIONS=false

# Set to true to log every Drizzle query at debug level
LOG_QUERIES=false

# JWT — secret must be at least 32 characters
JWT_SECRET=change-me-in-production-make-this-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=http://localhost:5173

# Google OAuth — leave empty to disable Google sign-in
# GOOGLE_REDIRECT_URI must match the origin that calls initCodeClient (popup mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Facebook Login — leave APP_ID/SECRET empty to disable
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v21.0

# Sign in with Apple — APPLE_SERVICE_ID is the Services ID configured in
# the Apple Developer console (e.g. com.example.signin). Leave empty to
# disable. The id_token's "aud" claim must equal this value.
APPLE_SERVICE_ID=
